/dts-v1/;

/* Digi ConnectCore MP25 (SOM) */
#include "ccmp25.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/regulator/st,stm32mp25-regulator.h>
#include "dt-bindings/pwm/pwm.h"

/ {
	model = "Digi International ConnectCore MP25 Viena PLC V1";
	compatible = "digi,ccmp25-dvk", "digi,ccmp25", "digi,ccmp2", "st,stm32mp255";
	digi,machine,name = "ccmp255-dvk";

	system-info {
    	compatible = "Viena,system-info";
		product-id = "Viena-CCMP25";
    	pcb-revision = "Rev 1.0";
    	firmware-version = "DEY5.0r3-20260427-dualdisplay-version";
	};

	aliases {
		ethernet0 = &eth1;
		ethernet1 = &eth2;
		serial2 = &uart5; /* Console M33 */
		serial3 = &usart6; /* COMM */
	};

	chosen {
		stdout-path = "serial0:115200n8";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer {
			compatible = "simple-framebuffer";
			clocks = <&rcc CK_BUS_LTDC>, <&rcc CK_KER_LTDC>,
				 <&rcc CK_BUS_LVDS>, <&rcc CK_KER_LVDSPHY>;
			status = "disabled";
		};
	};

	clocks {
		cec_clock: cec-clock {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <12000000>;
		};

		clk_ext_camera: clk-ext-camera {
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <24000000>;
		};

		pad_clk: pad-clk {
			#clock-cells = <0>;
			compatible = "fixed-clock";
			clock-frequency = <100000000>;
		};
	};

	hdmi_connector: hdmi-connector {
		compatible = "hdmi-connector";
		label = "hdmi";
		type = "a";
		hdmi-pwr-supply = <&reg_5v_board>;
		lv-pwr-supply = <&scmi_ldo7>; /* 1V8_HDMI */
		// hpd-gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
		status = "okay";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&lt8912_out>;
			};
		};
	};

	panel_hx3248c_backlight: panel-lvds-pwm-backlight {
		compatible = "pwm-backlight";
		/* node TIM16_CH1 period (ns)  20kHz = 50000 */
		pwms = <&pwm_lvds_bckl 0 50000 0>;
		enable-gpios = <&gpiof 11 GPIO_ACTIVE_HIGH>;
    	// brightness-levels = <0 5 15 30 50 75 100 130 165 205 255>;
		brightness-levels = <255 180 170 150 130 100 70 45 25 10 0>;     
    	/* 反相关系，默认亮度：索引 7 → 值 45 ，约50%占空比 */
    	default-brightness-level = <7>;
		power-supply = <&reg_5v_board>;
		power-on-delay-ms = <5>;
    	power-off-delay-ms = <5>;
		status = "okay";
	};

	panel_lvds: panel-lvds {
		compatible = "panel-lvds";
		power-supply = <&reg_3v3_board>;
		/*backlight = <&panel_lvds_gpio_backlight>;*/
		backlight = <&panel_hx3248c_backlight>;
		status = "okay";

		width-mm = <235>;
		height-mm = <143>;
		data-mapping = "vesa-24";

		panel-timing {
			clock-frequency = <51200000>;
			hactive = <1024>;
        	vactive = <600>;
	        hfront-porch = <160>;
    	    hback-porch = <160>;
        	hsync-len = <10>;
	        vfront-porch = <12>;
    	    vback-porch = <23>;
        	vsync-len = <3>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
		};

		port {
			lvds_panel_in: endpoint {
				remote-endpoint = <&lvds_out0>;
			};
		};
	};



	power_button {
		compatible = "digi,stpmic-pwrkey";
		interrupts-extended = <&optee 0>, <&optee 1>;
		interrupt-names = "stpmic_pwrkey_fall", "stpmic_pwrkey_rise";
		status = "okay";
	};


	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		reg_3v3_board: regulator-board@1 {
			compatible = "regulator-fixed";
			reg = <1>;
			regulator-name = "3v3_board";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-always-on;
			status = "okay";
		};

		reg_5v_board: regulator-board@2 {
			compatible = "regulator-fixed";
			reg = <2>;
			regulator-name = "5v_board";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			regulator-enable-ramp-delay = <8000>;
			gpio = <&gpiog 7 GPIO_ACTIVE_HIGH>; /* 5V_BOARD_EN */
			enable-active-high;
			status = "okay";
		};
	};

	/* AUDIO */
    sound_max98357: sound-max98357 {
        compatible = "audio-graph-card";
        label = "ccmp25-Viena-board";
        status = "okay";
        dais = <&sai1a_port &max98357_out_dai>;
    };

    // MAX98357 Codec 设备节点
    max98357: max98357@0 {
        #sound-dai-cells = <0>;
        compatible = "maxim,max98357a";
        //reg = <0>;
        status = "okay";

        maxim,gain = <2>; 
		sdmode-gpios = <&gpioz 4 GPIO_ACTIVE_HIGH>;

        // 如果 SD/MODE 引脚由硬件固定，不需要软件控制，可以不写以下属性
        // maxim,mode = "i2s"; 

        // 定义端口和端点
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
            reg = <0>;
            max98357_out_dai: endpoint {
                remote-endpoint = <&sai1a_endpoint>;
            };
        };
    };


	digital-io {
		status = "okay";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&ccmp25_gpio_pins &ccmp25_gpio_z_pins>;
		pinctrl-1 = <&ccmp25_gpio_sleep_pins &ccmp25_gpio_z_sleep_pins>;
	};
};

&sai1 {
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&ccmp25_sai1a_pins>;
    pinctrl-1 = <&ccmp25_sai1a_sleep_pins>;
    status = "okay";
};

&sai1a {
    status = "okay";

    sai1a_port: port {
        sai1a_endpoint: endpoint {
            remote-endpoint = <&max98357_out_dai>; 
            format = "i2s";
            dai-tdm-slot-num = <2>;
            dai-tdm-slot-width = <32>;
        };
    };
};


&eth1 {

	status = "okay";
	pinctrl-0 = <&eth1_rgmii_pins_a &eth1_mdio_pins_a>;
	pinctrl-1 = <&eth1_rgmii_sleep_pins_a &eth1_mdio_sleep_pins_a>;
	pinctrl-names = "default", "sleep";
	phy-mode = "rgmii-id";
	max-speed = <1000>;
	phy-handle = <&phy1_eth1>;
	st,eth-clk-sel;
	snps,ext-systime;

	mdio1 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";
		phy1_eth1: ethernet-phy@4 {
			compatible = "ethernet-phy-id001c.c916";
			reset-gpios =  <&gpiob 2 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <80000>;
			realtek,eee-disable;
			reg = <4>;
		};
	};
};

&eth2 {

	status = "okay";
	pinctrl-0 = <&eth2_rgmii_pins_a>;
	pinctrl-1 = <&eth2_rgmii_sleep_pins_a>;
	pinctrl-names = "default", "sleep";
	phy-mode = "rgmii-id";
	max-speed = <1000>;
	phy-handle = <&phy1_eth2>;
	st,eth-ptp-from-rcc;

	mdio1 {
		#address-cells = <1>;
		#size-cells = <0>;
		compatible = "snps,dwmac-mdio";
		phy1_eth2: ethernet-phy@1 {
			compatible = "ethernet-phy-id001c.c916";
			reset-gpios =  <&gpiog 6 GPIO_ACTIVE_LOW>;
			reset-assert-us = <10000>;
			reset-deassert-us = <80000>;
			realtek,eee-disable;
			reg = <1>;
		};
	};

};

&dsi {
	vdd-supply =  <&scmi_vddcore>;
	vdda18-supply = <&scmi_v1v8>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dsi_in: endpoint {
				remote-endpoint = <&ltdc_ep0_out>;
			};
		};

		port@1 {
			reg = <1>;
			dsi_out: endpoint {
				remote-endpoint = <&lt8912_1_in>;
			};
		};
	};
};

&spi3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&ccmp25_spi3_pins>;
	pinctrl-1 = <&ccmp25_spi3_sleep_pins>;
	cs-gpios = <&gpiob 1 GPIO_ACTIVE_LOW>;

	status = "okay";

	spidev@0 {
    	compatible = "rohm,dh2228fv";
    	reg = <0>;
    	spi-max-frequency = <2000000>;
	};
    
	touchscreen: touchscreen@0 {
		compatible = "ti,tsc2046";       /* tsc2046 */
		reg = <0>;                        /* SPI片选0 */
		spi-max-frequency = <2000000>;
		vcc-supply = <&reg_3v3_board>;
        
		interrupt-parent = <&gpiod>;
		interrupts = <5 IRQ_TYPE_EDGE_FALLING>;
		pendown-gpio = <&gpiod 5 GPIO_ACTIVE_LOW>;

 		ti,x-min = /bits/ 16 <50>;
		ti,x-max = /bits/ 16 <4050>;
		ti,y-min = /bits/ 16 <50>;
		ti,y-max = /bits/ 16 <4050>;
		ti,x-plate-ohms = /bits/ 16 <690>;

		//ti,pressure-min = /bits/ 16 <80>; 
		ti,pressure-max = /bits/ 16 <4095>; 

		// touchscreen-average-samples = <4>
		ti,debounce-max = <50>;
        ti,debounce-tol = <15>;
		ti,debounce-rep = <3>;
		ti,settle-delay-usec = <150>;
		ti,settle-samples; 
		ti,vref-delay-usecs = <100>;
		//penirq-recheck-delay-usecs = <15>;
		ti,keep-vref-on;
		//ti,vref-mv = <0>;

		wakeup-source;
		status = "disabled";

    };
};

/* Peripheral I2C bus (J18 Connector) */
&i2c1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&ccmp25_i2c1_pins>;
	pinctrl-1 = <&ccmp25_i2c1_sleep_pins>;
	i2c-scl-rising-time-ns = <185>;
	i2c-scl-falling-time-ns = <20>;
	clock-frequency = <400000>;
	status = "okay";
	/* spare dmas for other usage */
	/delete-property/dmas;
	/delete-property/dma-names;


	ext_rtc: ext_rtc@52 {
		compatible = "microcrystal,rv3028";
		reg = <0x52>;
		interrupt-parent = <&gpiof>;
		interrupts = <4 IRQ_TYPE_EDGE_FALLING>; /* RTC_INT_N */
		wakeup-source;
	};
};

&i2c3 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&ccmp25_i2c3_pins>;
	pinctrl-1 = <&ccmp25_i2c3_sleep_pins>;
	i2c-scl-rising-time-ns = <185>;
	i2c-scl-falling-time-ns = <20>;
	clock-frequency = <400000>;
	status = "okay";
	/* spare dmas for other usage */
	/delete-property/dmas;
	/delete-property/dma-names;

	lt_bridge: lt8912@48 {
		compatible = "lontium,lt8912b";
		reg = <0x48>;
		reset-gpios = <&gpiod 4 GPIO_ACTIVE_LOW>;
		vdd-supply = <&scmi_ldo7>; /* 1V8_HDMI */
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				lt8912_1_in: endpoint {
					data-lanes = <1 2 3 4>;
					remote-endpoint = <&dsi_out>;
				};
			};

			port@1 {
				reg = <1>;
				lt8912_out: endpoint {
					remote-endpoint = <&hdmi_connector_in>;
				};
			};
		};

		display-timings {
			native-mode = <&timing2>;

			/* High Definition */
			timing0: timing0 {
				clock-frequency = <74250000>;
				hactive = <1280>;
				vactive = <720>;
				hfront-porch = <110>;
				hsync-len = <40>;
				hback-porch = <220>;
				vfront-porch = <5>;
				vsync-len = <5>;
				vback-porch = <20>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};

			/* Full HD */
			timing1: timing1 {
				clock-frequency = <148500000>;
				hactive = <1920>;
				vactive = <1080>;
				hfront-porch = <88>;
				hsync-len = <44>;
				hback-porch = <148>;
				vfront-porch = <4>;
				vsync-len = <5>;
				vback-porch = <36>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};

			/* lvds clone */

			timing2: timing2 {
                    clock-frequency = <51200000>;
                    hactive = <1024>;
                    vactive = <600>;
                    hfront-porch = <160>;
                    hsync-len = <10>;
                    hback-porch = <160>;
                    vfront-porch = <12>;
                    vsync-len = <3>;
                    vback-porch = <23>;
                    hsync-active = <0>;
                    vsync-active = <0>;
                    de-active = <1>;
                    pixelclk-active = <0>;
                };
		};
	};

};

&i2c8 {
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&ccmp25_i2c8_z_pins>;
    pinctrl-1 = <&ccmp25_i2c8_z_sleep_pins>;
    status = "okay";

    /* USER CODE BEGIN i2c8 */
    /delete-property/dmas;
    /delete-property/dma-names;

    //clock-frequency = <400000>;
    //i2c-scl-rising-time-ns = <185>;
    //i2c-scl-falling-time-ns = <20>;
};

&ltdc {
	/* rotation-memory = <&ltdc_sec_rotation>; */
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		ltdc_ep0_out: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&dsi_in>;
		};

		ltdc_ep1_out: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&lvds_in>;
		};
	};
};


&lvds {
	vdd-supply =  <&scmi_vddcore>;
	vdda18-supply = <&scmi_v1v8>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			lvds_in: endpoint {
				remote-endpoint = <&ltdc_ep1_out>;
			};
		};

		port@1 {
			reg = <1>;
			lvds_out0: endpoint {
				remote-endpoint = <&lvds_panel_in>;
			};
		};
	};
};

/* FDCAN1 */
&m_can1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&ccmp25_can1_pins>;
	pinctrl-1 = <&ccmp25_can1_sleep_pins>;
	status = "okay";
};



/* Micro SD */
&sdmmc3 {
	pinctrl-names = "default", "opendrain", "sleep";
	pinctrl-0 = <&sdmmc3_b4_pins_a>;
	pinctrl-1 = <&sdmmc3_b4_od_pins_a>;
	pinctrl-2 = <&sdmmc3_b4_sleep_pins_a>;
	cd-gpios = <&gpiod 3 GPIO_ACTIVE_LOW>;
	disable-wp;
	st,neg-edge;
	no-1-8-v;
	bus-width = <4>;
	vmmc-supply = <&reg_3v3_board>; /* card's VDD pin */
	vqmmc-supply = <&scmi_vddio3>;
	status = "okay";
};

&timers8 {
    status = "disabled";

    /* USER CODE BEGIN timers8 */
    /delete-property/dmas;
    /delete-property/dma-names;
    /* USER CODE END timers8 */

    /* Set the desired PWM name */
    pwm28: pwm {
        pinctrl-names = "default", "sleep";
        pinctrl-0 = <&ccmp25_timers8_ch1_2_pwm_pins>;
        pinctrl-1 = <&ccmp25_timers8_ch1_2_pwm_sleep_pins>;
        status = "okay";
    };

    /*
     * Uncomment to enable timer trigger on STANDARD TIMER.
     *
     * Set <TRIGGER_INDEX> to (timer_index - 1)
     */
    //timer@<TRIGGER_INDEX> {
    //    status = "okay";
    //};

    /*
     * Uncomment to enable timer trigger on LPTIMER only.
     *
     * Set <TRIGGER_INDEX> to (lptimer_index - 1)
     */
    //trigger@<TRIGGER_INDEX> {
    //    status = "okay";
    //};

    /*
     * Uncomment and configure to enable counter/quadrature decoder.
     */
    //counter {
    //    status = "okay";
    //};
};


&timers16 {
    status = "okay";

    /* USER CODE BEGIN timers16 */
    /delete-property/dmas;
    /delete-property/dma-names;
    /* USER CODE END timers16 */

    /* Set the desired PWM name */
    pwm_lvds_bckl: pwm {
        pinctrl-names = "default", "sleep";
        pinctrl-0 = <&ccmp25_timers16_ch1_pwm_pins>;
        pinctrl-1 = <&ccmp25_timers16_ch1_pwm_sleep_pins>;
        status = "okay";
    };

    /*
     * Uncomment to enable timer trigger on STANDARD TIMER.
     *
     * Set <TRIGGER_INDEX> to (timer_index - 1)
     */
    timer@15 {
        status = "okay";
    };

    /*
     * Uncomment to enable timer trigger on LPTIMER only.
     *
     * Set <TRIGGER_INDEX> to (lptimer_index - 1)
     */
    //trigger@<TRIGGER_INDEX> {
    //    status = "okay";
    //};
};

&uart5 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&ccmp25_uart5_pins>;
	pinctrl-1 = <&ccmp25_uart5_sleep_pins>;
	status = "okay";

	/* USER CODE BEGIN uart5 */
	/delete-property/dmas;
	/delete-property/dma-names;
	/* USER CODE END uart5 */
};

/* Console A35 */
&usart2 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&ccmp25_usart2_pins>;
	pinctrl-1 = <&ccmp25_usart2_sleep_pins>;
	/delete-property/dmas;
	/delete-property/dma-names;
	status = "okay";
};

&usart6 {
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&ccmp25_usart6_board_pins>;
    pinctrl-1 = <&ccmp25_usart6_board_sleep_pins>;
    status = "okay";

    /* USER CODE BEGIN usart6 */
    /delete-property/dmas;
    /delete-property/dma-names;
    //linux,rs485-enabled-at-boot-time; // Set when using RS485.
    uart-has-rtscts;
    /* USER CODE END usart6 */
};

/* USB 2.0 Host */
&usb2_phy1 {
	vdd33-supply = <&scmi_vdd3v3_usb>;
	status = "okay";
};


&usbh {
	status = "okay";
};

&usbh_ehci {
	status = "okay";
};

&usbh_ohci {
    status = "okay";
};

/* USB 2.0/3.0 Host/Device */
&usb2_phy2 {
	vdd33-supply = <&scmi_vdd3v3_usb>;
	status = "okay";
};

&usb3dr {
	status = "okay";

	dwc3: usb@48300000 {
		maximum-speed = "high-speed";
		usb-role-switch;
		role-switch-default-mode = "peripheral";
	};
};


&pinctrl {
	ccmp25_sai1a_pins: ccmp25-sai1a {
        pins {
            pinmux = <STM32_PINMUX('D',  9,  AF3)>, /* SAI1_SD_A */
                     <STM32_PINMUX('D',  8,  AF3)>, /* SAI1_FS_A */
                     <STM32_PINMUX('D', 10,  AF3)>; /* SAI1_SCK_A */
            drive-push-pull;
            bias-disable;
            slew-rate = <0>;
        };
    };

    ccmp25_sai1a_sleep_pins: ccmp25-sai1a-sleep {
        pins {
            pinmux = <STM32_PINMUX('D',  9, ANALOG)>, /* SAI1_SD_A */
                     <STM32_PINMUX('D',  8, ANALOG)>, /* SAI1_FS_A */
                     <STM32_PINMUX('D', 10, ANALOG)>; /* SAI1_SCK_A */
        };
    };

	ccmp25_can1_pins: ccmp25-can1 {
		pins1 {
			pinmux = <STM32_PINMUX('G', 11,  AF7)>; /* FDCAN1_TX */
			drive-push-pull;
			bias-disable;
			slew-rate = <1>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('G', 12,  AF7)>; /* FDCAN1_RX */
			bias-disable;
		};
	};

	ccmp25_can1_sleep_pins: ccmp25-can1-sleep {
		pins {
			pinmux = <STM32_PINMUX('G', 11, ANALOG)>, /* FDCAN1_TX */
					 <STM32_PINMUX('G', 12, ANALOG)>; /* FDCAN1_RX */
		};
	};

    ccmp25_spi3_pins: ccmp25-spi3 {
        pins1 {
            pinmux = <STM32_PINMUX('B',  8,  AF1)>, /* SPI3_MOSI */
                     <STM32_PINMUX('B',  7,  AF1)>; /* SPI3_SCK */
            drive-push-pull;
            bias-disable;
            slew-rate = <1>;
        };
        pins2 {
            pinmux = <STM32_PINMUX('B', 10,  AF1)>; /* SPI3_MISO */
            bias-pull-up;
        };
    };
    
    ccmp25_spi3_sleep_pins: ccmp25-spi3-sleep {
        pins {
            pinmux = <STM32_PINMUX('B',  8, ANALOG)>, /* SPI3_MOSI */
                     <STM32_PINMUX('B', 10, ANALOG)>, /* SPI3_MISO */
                     <STM32_PINMUX('B',  7, ANALOG)>; /* SPI3_SCK */
        };
    };

	ccmp25_gpio_pins: ccmp25-gpio {

		pins1 {
			pinmux = <STM32_PINMUX('F',  11, GPIO)>;  /* PF11_GPIO */
			drive-push-pull;
			bias-disable;
			slew-rate = <0>;
		};
		pins2 {
            pinmux = <STM32_PINMUX('A', 12, GPIO)>, /* PA12_GPIO */
					 <STM32_PINMUX('F', 10, ANALOG)>, /* DI13_GPIO */
					 <STM32_PINMUX('B',  3, GPIO)>, /* PB3_GPIO */
					 <STM32_PINMUX('B',  15, ANALOG)>,  /* PB15_GPIO_DIN */ 					 
					 <STM32_PINMUX('G',  3, GPIO)>, /* LED_WARNING_GPIO */					 
					 <STM32_PINMUX('G',  5, GPIO)>,  /* PG5_GPIO */
					 <STM32_PINMUX('G',  8, ANALOG)>,  /* PG8_GPIO_DIN */
					 <STM32_PINMUX('F',  10, GPIO)>,  /* PF10_GPIO_DIN */
					 <STM32_PINMUX('F',  13, GPIO)>,  /* PF13_GPIO */
					 <STM32_PINMUX('F',  3, GPIO)>,  /* PF3_GPIO */
					 <STM32_PINMUX('D',  6, GPIO)>,  /* PD6_GPIO */
					 <STM32_PINMUX('F',  4, GPIO)>,  /* PF4_GPIO */
					 <STM32_PINMUX('G',  4, GPIO)>, /* PG4_GPIO */
					 <STM32_PINMUX('H',  2, ANALOG)>,  /* PH2_GPIO  related to TIM16 */ 
					 <STM32_PINMUX('H',  6, ANALOG)>,  /* PH2_GPIO  related to TIM16 */ 
					 <STM32_PINMUX('H',  3, ANALOG)>,  /* PH3_GPIO_DIN */					 					 
					 <STM32_PINMUX('H',  4, GPIO)>,  /* PH4_GPIO */ 					 
					 <STM32_PINMUX('H',  5, ANALOG)>,  /* PH5_GPIO_DIN */
					 <STM32_PINMUX('F',  15, ANALOG)>,  /* PF15_GPIO_DIN */  
					 <STM32_PINMUX('I',  8, GPIO)>, /* PI8/LPO32_GPIO */
					 <STM32_PINMUX('I',  9, GPIO)>, /* PI9_GPIO */
					 <STM32_PINMUX('I',  10, ANALOG)>,  /* PI10_GPIO_DIN */ 
					 <STM32_PINMUX('A',  1, ANALOG)>,  /* PA1_GPIO_DIN */ 
					 <STM32_PINMUX('A',  7, ANALOG)>,  /* PA7_GPIO_DIN */
					 <STM32_PINMUX('F',  12, ANALOG)>,  /* PF12_GPIO_DIN */
					 <STM32_PINMUX('I',  6, ANALOG)>;  /* PI6_GPIO_DIN */					    
            bias-disable;
        };
	};

	ccmp25_gpio_sleep_pins: ccmp25-gpio-sleep {
		pins {
			pinmux = <STM32_PINMUX('F', 10, ANALOG)>, /* PF10_GPIO */
					 <STM32_PINMUX('I',  0, ANALOG)>, /* SAI4_MCLK_B_GPIO */
					 <STM32_PINMUX('G',  3, ANALOG)>, /* PG3_GPIO */
					 <STM32_PINMUX('G',  8, ANALOG)>,  /* PG8_GPIO_DIN */
					 <STM32_PINMUX('I',  9, ANALOG)>, /* PI9_GPIO */
					 <STM32_PINMUX('B',  3, ANALOG)>, /* PB3_GPIO */
					 <STM32_PINMUX('A',  7, ANALOG)>,  /* PA7_GPIO_DIN */
					 <STM32_PINMUX('A', 12, ANALOG)>, /* PA12_GPIO */
					 <STM32_PINMUX('G',  4, ANALOG)>, /* PG4_GPIO */
					 <STM32_PINMUX('G',  5, ANALOG)>,  /* PG5_GPIO */
					 <STM32_PINMUX('F',  11, ANALOG)>,  /* PF11_GPIO */
					 <STM32_PINMUX('F',  13, ANALOG)>,  /* PF13_GPIO */
					 <STM32_PINMUX('F',  3, ANALOG)>,  /* PF3_GPIO */
					 <STM32_PINMUX('D',  6, ANALOG)>,  /* PD6_GPIO */
					 <STM32_PINMUX('F',  4, ANALOG)>,  /* PF4_GPIO */
					 <STM32_PINMUX('I',  4, ANALOG)>,  /* PGI4_GPIO */ 
					 <STM32_PINMUX('H',  2, ANALOG)>,  /* PH2_GPIO  related to TIM16 */ 
					 <STM32_PINMUX('H',  6, ANALOG)>,  /* PH2_GPIO  related to TIM16 */ 					 
					 <STM32_PINMUX('H',  5, ANALOG)>,  /* PH5_GPIO */
					 <STM32_PINMUX('F',  15, ANALOG)>,  /* PF15_GPIO */  
					 <STM32_PINMUX('I',  10, ANALOG)>,  /* PI10_GPIO */ 
					 <STM32_PINMUX('A',  1, ANALOG)>,  /* PA1_GPIO */ 
					 <STM32_PINMUX('F',  12, ANALOG)>,  /* PF12_GPIO */
					 <STM32_PINMUX('H',  4, ANALOG)>;  /* PH4_GPIO */ 
		};
	};

    ccmp25_timers1ch1_2_pwm_pins: ccmp25-timers1ch1_2-pwm {
        pins {
            pinmux = <STM32_PINMUX('D', 7, GPIO)>,  /* TIM1_CH1 */
                     <STM32_PINMUX('D', 10, GPIO)>; /* TIM1_CH2 */
            drive-push-pull;
            bias-disable;
            slew-rate = <1>;  // high speed 
        };
    };

    ccmp25_timers1ch1_2_pwm_sleep_pins: ccmp25-timers1ch1_2-pwm-sleep {
        pins {
			pinmux = <STM32_PINMUX('D', 7, ANALOG)>, /* TIM1_CH1_PWM */
                     <STM32_PINMUX('D', 10, ANALOG)>;  /* TIM1_CH2_PWM */
        };
    };

	ccmp25_i2c1_pins: ccmp25-i2c1 {
		pins {
			pinmux = <STM32_PINMUX('G', 13,  AF9)>, /* I2C1_SCL */
					 <STM32_PINMUX('I',  1,  AF9)>; /* I2C1_SDA */
			drive-open-drain;
			bias-disable;
			slew-rate = <0>;
		};
	};

	ccmp25_i2c1_sleep_pins: ccmp25-i2c1-sleep {
		pins {
			pinmux = <STM32_PINMUX('G', 13, ANALOG)>, /* I2C1_SCL */
					 <STM32_PINMUX('I',  1, ANALOG)>; /* I2C1_SDA */
		};
	};

	ccmp25_i2c3_pins: ccmp25-i2c3 {
		pins {
			pinmux = <STM32_PINMUX('G',  1,  AF9)>, /* I2C3_SCL */
					 <STM32_PINMUX('G',  2,  AF9)>; /* I2C3_SDA */
			drive-open-drain;
			bias-disable;
			slew-rate = <0>;
		};
	};

	ccmp25_i2c3_sleep_pins: ccmp25-i2c3-sleep {
		pins {
			pinmux = <STM32_PINMUX('G',  1, ANALOG)>, /* I2C3_SCL */
					 <STM32_PINMUX('G',  2, ANALOG)>; /* I2C3_SDA */
		};
	};

	ccmp25_uart5_pins: ccmp25-uart5 {
		pins1 {
			pinmux = <STM32_PINMUX('G',  9,  AF5)>; /* UART5_TX */
			drive-push-pull;
			bias-disable;
			slew-rate = <0>;
		};
		pins2 {
			pinmux = <STM32_PINMUX('G', 10,  AF5)>; /* UART5_RX */
			bias-disable;
		};
	};

	ccmp25_uart5_sleep_pins: ccmp25-uart5-sleep {
		pins {
			pinmux = <STM32_PINMUX('G',  9, ANALOG)>, /* UART5_TX */
					 <STM32_PINMUX('G', 10, ANALOG)>; /* UART5_RX */
		};
	};


	ccmp25_usart2_pins: ccmp25-usart2 {
		pins1 {
			pinmux = <STM32_PINMUX('A',  8,  AF8)>; /* USART2_RX */
			bias-disable;
		};
		pins2 {
			pinmux = <STM32_PINMUX('A',  4,  AF6)>; /* USART2_TX */
			drive-push-pull;
			bias-disable;
			slew-rate = <0>;
		};
	};

	ccmp25_usart2_sleep_pins: ccmp25-usart-sleep-2 {
		pins {
			pinmux = <STM32_PINMUX('A',  8, ANALOG)>, /* USART2_RX */
					 <STM32_PINMUX('A',  4, ANALOG)>; /* USART2_TX */
		};
	};

    ccmp25_usart6_board_pins: ccmp25-usart6 {
        pins1 {
            pinmux = <STM32_PINMUX('F',  5,  AF3)>, /* USART6_TX */
                     <STM32_PINMUX('G',  5,  AF3)>; /* USART6_DE */
            drive-push-pull;
            bias-disable;
            slew-rate = <0>;
        };
        pins2 {
            pinmux = <STM32_PINMUX('F', 14,  AF3)>; /* USART6_RX */
            bias-disable;
        };
    };

    ccmp25_usart6_board_sleep_pins: ccmp25-usart-sleep-6 {
        pins {
            pinmux = <STM32_PINMUX('F',  5, ANALOG)>, /* USART6_TX */
                     <STM32_PINMUX('F', 14, ANALOG)>, /* USART6_RX */
                     <STM32_PINMUX('G',  5, ANALOG)>; /* USART6_DE */
        };
    };

    ccmp25_can1_pins: ccmp25-can1 {
        pins1 {
            pinmux = <STM32_PINMUX('G', 11,  AF7)>; /* FDCAN1_TX */
            drive-push-pull;
            bias-disable;
            slew-rate = <1>;
        };
        pins2 {
            pinmux = <STM32_PINMUX('G', 12,  AF7)>; /* FDCAN1_RX */
            bias-disable;
        };
    };
    
    ccmp25_can1_sleep_pins: ccmp25-can1-sleep {
        pins {
            pinmux = <STM32_PINMUX('G', 11, ANALOG)>, /* FDCAN1_TX */
                     <STM32_PINMUX('G', 12, ANALOG)>; /* FDCAN1_RX */
        };
    };

	ccmp25_timers8_ch1_2_pwm_pins: ccmp25-timers8-ch1_2-pwm {
        pins {
            pinmux = <STM32_PINMUX('I',  2,  GPIO)>,  /* TIM8_CH1 */
					 <STM32_PINMUX('I',  3,  GPIO)>; /* TIM8_CH2 */
            drive-push-pull;
            bias-disable;
            slew-rate = <0>;
        };
    };

    ccmp25_timers8_ch1_2_pwm_sleep_pins: ccmp25-timers8-ch1_2-pwm-sleep {
        pins {
            pinmux = <STM32_PINMUX('I',  2, ANALOG)>, /* TIM8_CH1 */
					 <STM32_PINMUX('I',  3, ANALOG)>; /* TIM8_CH2 */
        };
    };

    ccmp25_timers16_ch1_pwm_pins: ccmp25-timers16-ch1-pwm {
        pins {
            pinmux = <STM32_PINMUX('B',  0,  AF7)>; /* TIM16_CH1_PWM */
            drive-push-pull;
            bias-disable;
            slew-rate = <1>;
        };
    };

    ccmp25_timers16_ch1_pwm_sleep_pins: ccmp25-timers16-ch1-pwm-sleep {
        pins {
            pinmux = <STM32_PINMUX('B',  0, ANALOG)>; /* TIM16_CH1_PWM */
        };
    };

};

&pinctrl_z {
	ccmp25_gpio_z_pins: ccmp25-gpio {
		pins1 {
			pinmux = <STM32_PINMUX('Z',  7, ANALOG)>, /* PZ7_GPIO_DIN */
					 <STM32_PINMUX('Z',  8, ANALOG)>, /* PZ8_GPIO_DIN */
					 <STM32_PINMUX('Z',  1, ANALOG)>, /* PZ1_GPIO */
					 <STM32_PINMUX('Z',  0, ANALOG)>, /* PZ0_GPIO_DIN */
					 <STM32_PINMUX('Z',  3, ANALOG)>; /* PZ3_GPIO */
			bias-disable;
			slew-rate = <0>;
		};
	};

	ccmp25_gpio_z_sleep_pins: ccmp25-gpio-sleep {
		pins {
			pinmux = <STM32_PINMUX('Z',  7, ANALOG)>, /* 3V3_RF_EN/PZ6_GPIO */
					 <STM32_PINMUX('Z',  8, ANALOG)>, /* PZ8_GPIO */
					 <STM32_PINMUX('Z',  1, ANALOG)>, /* PZ1_GPIO */
					 <STM32_PINMUX('Z',  0, ANALOG)>, /* PZ0_GPIO */
					 <STM32_PINMUX('Z',  3, ANALOG)>; /* PZ3_GPIO */
		};
	};

    ccmp25_i2c8_z_pins: ccmp25-i2c8 {
        pins {
            pinmux = <STM32_PINMUX('Z',  2,  AF8)>, /* I2C8_SCL */
                     <STM32_PINMUX('Z',  9,  AF8)>; /* I2C8_SDA */
            drive-open-drain;
            bias-disable;
            slew-rate = <0>;
        };
    };

    ccmp25_i2c8_z_sleep_pins: ccmp25-i2c8-sleep {
        pins {
            pinmux = <STM32_PINMUX('Z',  2, ANALOG)>, /* I2C8_SCL */
                     <STM32_PINMUX('Z',  9, ANALOG)>; /* I2C8_SDA */
        };
    };

};
