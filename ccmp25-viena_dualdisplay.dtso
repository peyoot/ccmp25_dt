/dts-v1/;
/plugin/;

/ {
    compatible = "digi,ccmp25-dvk", "digi,ccmp25", "digi,ccmp2", "st,stm32mp255";

    fragment@0 {
        target-path = "/";
        __overlay__ {
            overlay-description = "ccmp25viena: dual display LVDS + HDMI";
        };
    };
};

&hdmi_connector {
    status = "okay";
};

&dsi {
    status = "okay";
};

&lt_bridge {
    status = "okay";
};

/* 无需改动 lvds 和 panel,其本身已 okay */