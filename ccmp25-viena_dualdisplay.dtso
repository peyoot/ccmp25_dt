/dts-v1/;
/plugin/;

/ {
    compatible = "digi,ccmp25-dvk", "digi,ccmp25", "digi,ccmp2", "st,stm32mp255";

    fragment@0 {
        target-path = "/";
        __overlay__ {
            overlay-description = "ccmp25viena: LTDC clone to LVDS + HDMI";
        };
    };

    fragment@1 {
        target = "&hdmi_connector";
        __overlay__ {
            status = "okay";
        };
    };

    fragment@2 {
        target = "&dsi";
        __overlay__ {
            status = "okay";
        };
    };

    fragment@3 {
        target = "&lt_bridge";
        __overlay__ {
            status = "okay";
            display-timings {
                native-mode = <&timing_lvds_clone>;

                timing_lvds_clone: timing-lvds-clone {
                    clock-frequency = <51200000>;
                    hactive = <1024>;
                    vactive = <600>;
                    hfront-porch = <160>;
                    hsync-len = <10>;
                    hback-porch = <160>;
                    vfront-porch = <12>;
                    vsync-len = <3>;
                    vback-porch = <23>;
                    hsync-active = <0>;
                    vsync-active = <0>;
                    de-active = <1>;
                    pixelclk-active = <0>;
                };
            };
        };
    };

    /* 无需改动 lvds 和 panel，其本身已 okay */
};